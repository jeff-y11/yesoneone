# Application Secrets Template
# Copy this file to application-secrets.properties in the directory the application is started from.
# The file is loaded from the working directory (./application-secrets.properties) and is NOT packaged into the jar.
# DO NOT commit application-secrets.properties to version control.

# JWT signing secret - generate a random value, e.g. openssl rand -base64 64
geodevai.jwt.secret=CHANGE_ME_random_secret

# PostgreSQL password (not needed for the DEV profile, which uses H2)
spring.datasource.password=CHANGE_ME

# Google OAuth2 credentials
spring.security.oauth2.client.registration.google.client-id=CHANGE_ME.apps.googleusercontent.com
spring.security.oauth2.client.registration.google.client-secret=CHANGE_ME
